<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Silent runs hour-long orchestrations: App Nap and automatic termination must never pause it while the window is
       hidden or the screen is locked (2026-10-02: the webview stopped polling and every chain stalled at night). -->
  <key>LSAppNapIsDisabled</key>
  <true/>
  <key>NSSupportsAutomaticTermination</key>
  <false/>
  <key>NSSupportsSuddenTermination</key>
  <false/>
</dict>
</plist>
