{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Silent main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "log:default",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    "dialog:default",
    "dialog:allow-open",
    "shell:allow-open",
    "process:default",
    "window-state:default"
  ]
}
